# 环境变量示例。复制为 .env 后按需修改；不要提交真实密钥。
# 所有值都有代码内默认值，本地演示不配置也能启动。

APP_NAME=云账科技 企业财税费控支持与工单系统
APP_ENV=local
APP_DEBUG=false
APP_HOST=127.0.0.1
APP_PORT=8000
LOG_LEVEL=INFO

# 默认 SQLite；切换 PostgreSQL 时取消注释并安装 asyncpg
DATABASE_URL=sqlite+aiosqlite:///./data/app.db
# DATABASE_URL=postgresql+asyncpg://cloudledger:change-me@127.0.0.1:5432/cloudledger

# 留空时自动生成 data/.jwt_secret（仅适合本地）。
# 生产必须设置为足够长的随机字符串。
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=480

# LLM 模式：auto（有 Key 用模型，否则摘录式）/ extractive（始终摘录）/ openai（兼容 OpenAI 协议）
# LLM_API_KEY 留空且指向 DeepSeek 时，会自动回退读取系统环境变量 DEEPSEEK_API_KEY
LLM_MODE=auto
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat
LLM_TIMEOUT_SECONDS=30
LLM_TEMPERATURE=0.1

DATA_DIR=./data
UPLOAD_MAX_MB=5

# 检索与切分
CHUNK_SIZE=600
CHUNK_OVERLAP=80
EMBEDDING_DIM=512
RETRIEVAL_TOP_K=5
RETRIEVAL_THRESHOLD=0.2
